# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Virtualenvs
.venv/
venv/
env/

# Caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Build artifacts
*.egg-info/
build/
dist/
*.egg

# Jupyter
.ipynb_checkpoints/
*-checkpoint.ipynb

# Data. The raw BigQuery extracts and the 1.77M-row master table in data/processed/
# are regenerated by the make targets and the notebooks; don't commit them.
# data/summary/ (about 40 KB, built by `make summary`) IS committed: the dashboard,
# the Docker image and the Space read only that.
data/processed/*.parquet
data/processed/*.csv
data/processed/*.pkl
data/processed/*.feather
!data/processed/.gitkeep

# Secrets — never commit credentials
.env
.env.*
!.env.example
*.key
*-credentials.json
service-account*.json
*.pem

# OS
.DS_Store
Thumbs.db
desktop.ini

# IDEs
.vscode/
.idea/
*.swp
*.swo
*~

# Streamlit
.streamlit/secrets.toml

# Rendered PDFs are committed (small, useful for portfolio), but not LaTeX intermediates
*.aux
*.log
*.toc
*.out
