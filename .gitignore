# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Virtualenvs
.venv/
venv/
env/

# Caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Build artifacts
*.egg-info/
build/
dist/
*.egg

# Jupyter
.ipynb_checkpoints/
*-checkpoint.ipynb

# Data — large outputs are regenerated by make targets; don't commit them.
# Keep the .gitkeep files so the directories exist in version control.
data/processed/*.parquet
data/processed/*.csv
data/processed/*.pkl
data/processed/*.feather
!data/processed/.gitkeep

# Secrets — never commit credentials
.env
.env.*
!.env.example
*.key
*-credentials.json
service-account*.json
*.pem

# OS
.DS_Store
Thumbs.db
desktop.ini

# IDEs
.vscode/
.idea/
*.swp
*.swo
*~

# Streamlit
.streamlit/secrets.toml

# Rendered PDFs are committed (small, useful for portfolio), but not LaTeX intermediates
*.aux
*.log
*.toc
*.out
